{
  "type": "object",
  "properties": {
    "guardPolicy": {
      "title": "SecureIntent upload enforcement policy",
      "description": "Controls local scanner failure handling for protected destinations.",
      "type": "object",
      "properties": {
        "onUnavailable": {
          "type": "string",
          "enum": ["allow", "block"]
        },
        "onTooLarge": {
          "type": "string",
          "enum": ["allow", "block"]
        },
        "maxFileBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8388608
        },
        "scanTimeoutMs": {
          "type": "integer",
          "minimum": 250,
          "maximum": 10000
        },
        "protectedOrigins": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["http://localhost:4173", "http://127.0.0.1:4173"]
          }
        }
      }
    }
  }
}
